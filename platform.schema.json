{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tassosgomes/template-pipeline/platform.schema.json",
  "title": "platform.yml",
  "description": "Manifesto do serviço ou do monorepo. O formato single-service mantém o contrato legado; o formato monorepo usa servicos[].",
  "oneOf": [
    {
      "$ref": "#/$defs/singleService"
    },
    {
      "$ref": "#/$defs/monorepo"
    }
  ],
  "$defs": {
    "serviceName": {
      "type": "string",
      "description": "Identificador do serviço, em kebab-case.",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 63
    },
    "stack": {
      "type": "string",
      "description": "Stack do serviço. Determina qual workflow ci-*.yml da plataforma é usado.",
      "enum": ["dotnet", "java", "go", "node", "python", "react-ts"]
    },
    "description": {
      "type": "string",
      "description": "Uma linha sobre o que o serviço faz.",
      "maxLength": 200
    },
    "team": {
      "type": "string",
      "description": "Time dono do serviço. Deve corresponder a um time da organização no GitHub."
    },
    "criticality": {
      "type": "string",
      "description": "Criticidade de negócio. Governa o rigor esperado dos gates de segurança.",
      "enum": ["baixa", "media", "alta", "critica"],
      "default": "media"
    },
    "deploy": {
      "type": "object",
      "description": "Alvos de deploy por ambiente (consumido na Fase 3).",
      "additionalProperties": false,
      "properties": {
        "plataforma": {
          "type": "string",
          "enum": ["vercel", "coolify", "aws", "azure", "gcp", "oci", "nenhum"]
        },
        "ambientes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["dev", "staging", "prod"]
          },
          "uniqueItems": true
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Postura de segurança do serviço.",
      "additionalProperties": false,
      "properties": {
        "modo": {
          "type": "string",
          "description": "observe reporta sem reprovar; enforce reprova conforme a severidade.",
          "enum": ["observe", "enforce"],
          "default": "observe"
        },
        "reprovar-a-partir-de": {
          "type": "string",
          "enum": ["none", "critical", "high", "medium", "low"],
          "default": "high"
        },
        "dast": {
          "type": "boolean",
          "description": "Habilita o DAST. Exige aplicação containerizada com healthcheck.",
          "default": false
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slack": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "description": "Caminho relativo e canônico do serviço a partir da raiz do repositório.",
      "pattern": "^(?!\\.?$)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
      "maxLength": 255
    },
    "singleService": {
      "type": "object",
      "required": ["nome", "time", "stack"],
      "additionalProperties": false,
      "properties": {
        "nome": {
          "$ref": "#/$defs/serviceName"
        },
        "descricao": {
          "$ref": "#/$defs/description"
        },
        "time": {
          "$ref": "#/$defs/team"
        },
        "stack": {
          "$ref": "#/$defs/stack"
        },
        "criticidade": {
          "$ref": "#/$defs/criticality"
        },
        "deploy": {
          "$ref": "#/$defs/deploy"
        },
        "seguranca": {
          "$ref": "#/$defs/security"
        },
        "contato": {
          "$ref": "#/$defs/contact"
        }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Valores herdados pelos serviços que não os definirem localmente.",
      "additionalProperties": false,
      "properties": {
        "time": {
          "$ref": "#/$defs/team"
        },
        "criticidade": {
          "$ref": "#/$defs/criticality"
        },
        "deploy": {
          "$ref": "#/$defs/deploy"
        },
        "seguranca": {
          "$ref": "#/$defs/security"
        },
        "contato": {
          "$ref": "#/$defs/contact"
        }
      }
    },
    "monorepoService": {
      "type": "object",
      "required": ["nome", "path", "stack"],
      "additionalProperties": false,
      "properties": {
        "nome": {
          "$ref": "#/$defs/serviceName"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "descricao": {
          "$ref": "#/$defs/description"
        },
        "time": {
          "$ref": "#/$defs/team"
        },
        "stack": {
          "$ref": "#/$defs/stack"
        },
        "criticidade": {
          "$ref": "#/$defs/criticality"
        },
        "deploy": {
          "$ref": "#/$defs/deploy"
        },
        "seguranca": {
          "$ref": "#/$defs/security"
        },
        "contato": {
          "$ref": "#/$defs/contact"
        }
      }
    },
    "monorepo": {
      "type": "object",
      "required": ["servicos"],
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "$ref": "#/$defs/defaults"
        },
        "servicos": {
          "type": "array",
          "description": "Coleção canônica de serviços do monorepo.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/monorepoService"
          }
        }
      }
    }
  }
}
